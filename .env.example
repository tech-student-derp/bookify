# Bookify — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookify
DB_USER=root
DB_PASS=

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
# Leave MAIL_HOST empty to use the development stub (logs to backend/logs/mail_stub.log)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@bookify.local
MAIL_FROM_NAME=Bookify
