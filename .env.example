# Bookify — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=local
APP_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookify
DB_USER=root
DB_PASS=

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Bookify

# Cloudflare Turnstile (public site key is injected into the frontend build;
# secret key is read only by PHP and must never use a VITE_ prefix).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
